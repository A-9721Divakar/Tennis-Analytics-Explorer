# Copy to .env and fill in. Never commit the real .env file.
SPORTRADAR_API_KEY=your_api_key_here
SPORTRADAR_ACCESS_LEVEL=trial

# Leave DATABASE_URL empty to use a local SQLite file (data/tennis.db).
# PostgreSQL: postgresql://user:password@localhost:5432/tennis
# MySQL:      mysql+pymysql://user:password@localhost:3306/tennis
DATABASE_URL=

# Optional: protects the Data Admin page on a public deployment
ADMIN_PASSWORD=
